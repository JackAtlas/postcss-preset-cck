{
  "compilerOptions": {
    "lib": ["ESNext", "DOM"],
    "outDir": "./dist",
    "rootDir": "./src",
    "target": "esnext",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "esModuleInterop": true,
    "declaration": false
  },
  "exclude": [
    "node_modules",
    "dist",
    "src/*/*.test.ts",
    "src/tests/*",
    "./scripts"
  ]
}
