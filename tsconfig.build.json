{
  "compilerOptions": {
    "lib": ["ESNext", "DOM"],
    "outDir": "./dist",
    "rootDir": "./src",
    "target": "esnext",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "esModuleInterop": true,
    "declaration": true,
    "declarationMap": true,
    "types": ["node"],
    "skipLibCheck": true
  },
  "exclude": [
    "node_modules",
    "dist",
    "src/*/*.test.ts",
    "src/tests/*",
    "./scripts"
  ]
}
