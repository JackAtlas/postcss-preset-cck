{
  "compilerOptions": {
    "lib": ["ESNext", "DOM"],
    "outDir": "./dist",
    "target": "esnext",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "esModuleInterop": true,
    "declaration": false,
    "types": ["node"]
  },
  "include": ["./scripts", "./src"],
  "exclude": ["node_modules", "dist", "src/**/*.test.ts", "src/test/**"]
}
